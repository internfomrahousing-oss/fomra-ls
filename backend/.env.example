# Copy this file to .env and fill in your values

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT secret — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret_string

# Comma-separated list of web origins allowed to call the API (CORS).
# Defaults to the production app + localhost dev ports if unset.
ALLOWED_ORIGINS=https://fomra-ls.vercel.app,http://localhost:3000,http://localhost:8080

# Server port
PORT=3000
